<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="Pulsar Model Visualizar" Height="1350" Width="1080" ResizeMode="NoResize"
        HorizontalAlignment="Left" VerticalAlignment="Top">

    <Window.Resources>
        <!--矢印 Thumb 形状-->
        <PathGeometry x:Key="ArrowThumbGeometry">
            <PathFigure StartPoint="0,30" IsClosed="True">
                <BezierSegment Point1="40,20" Point2="80,15" Point3="120,0"/>
                <BezierSegment Point1="90,20" Point2="90,40" Point3="120,60"/>
                <BezierSegment Point1="80,45" Point2="40,40" Point3="0,30"/>
            </PathFigure>
        </PathGeometry>
        <!--矢印 Button 形状-->
        <PathGeometry x:Key="ArrowButtonGeometry">
            <PathFigure StartPoint="0,60" IsClosed="True">
                <BezierSegment Point1="40,40" Point2="80,20" Point3="120,0"/>
                <BezierSegment Point1="90,40" Point2="90,80" Point3="120,120"/>
                <BezierSegment Point1="80,100" Point2="40,80" Point3="0,60"/>
            </PathFigure>
        </PathGeometry>
        <!--矢印 Thumb ヨコ-->
        <Style x:Key="ArrowThumbVerticalStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Viewbox RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Viewbox.RenderTransform>
                            <Canvas Width="120" Height="60">
                                <Path x:Name="thumb" Fill="{TemplateBinding Background}" Data="{StaticResource ArrowThumbGeometry}"/>
                                <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}"
                                           Foreground="DimGray" FontSize="40" VerticalAlignment="Center" Margin="150,1,0,0"
                                           RenderTransformOrigin="0.5,0.5"/>
                            </Canvas>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Fill" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--矢印 Thumb タテ-->
        <Style x:Key="ArrowThumbHorizontalStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Viewbox RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="90"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Viewbox.RenderTransform>
                            <Canvas Width="120" Height="60">
                                <Path x:Name="thumb" Fill="{TemplateBinding Background}" Data="{StaticResource ArrowThumbGeometry}"/>
                                <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}"
                                           Foreground="DimGray" FontSize="40" VerticalAlignment="Center" Margin="150,1,0,0"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-90"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Fill" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--矢印 Button-->
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Viewbox Width="30" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Viewbox.RenderTransform>
                            <Path x:Name="button" Fill="{TemplateBinding Background}"
                                  Data="{StaticResource ArrowButtonGeometry}"/>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Click" Handler="PolarCapArrowButton_Click"/>
            <EventSetter Event="MouseEnter" Handler="PolarCapArrowButton_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="PolarCapArrowButton_MouseLeave"/>
        </Style>
        <!--星型 マーカー-->
        <ControlTemplate x:Key="StarMarkerTemplate" TargetType="ContentControl">
            <Viewbox Width="100" Height="100">
                <Path Fill="Transparent" Stroke="Yellow" StrokeThickness="5.0">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,50" IsClosed="True">
                                <BezierSegment Point1="40,40" Point2="40,40" Point3="50,0"/>
                                <BezierSegment Point1="60,40" Point2="60,40" Point3="100,50"/>
                                <BezierSegment Point1="60,60" Point2="60,60" Point3="50,100"/>
                                <BezierSegment Point1="40,60" Point2="40,60" Point3="0,50"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Viewbox>
        </ControlTemplate>
    </Window.Resources>


    <Grid Background="#f5f5f5">
        <!--Pulsar Model Visualizarタイトル-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="20,325,0,0" TextWrapping="Wrap" Text="Pulsar Model Visualizar" 
                   Foreground="Gray" FontSize="15" TextAlignment="Center" FontFamily="Century Gothic" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="20,358,0,0" TextWrapping="Wrap" Text="Outer Gap Model" 
                   Foreground="Gray" FontSize="9" TextAlignment="Center" FontFamily="Century Gothic" Height="11"/>


        <!--磁力線-->
        <gl:GLWpfControl x:Name="GLControlMagneticLine"
                         MouseDown="MagneticLineView_MouseDown"
                         MouseMove="MagneticLineView_MouseMove"
                         MouseUp="MagneticLineView_MouseUp"
                         MouseLeave="MagneticLineView_MouseLeave"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="600" Height="600" Margin="240,50,0,0"
                         MouseLeftButtonDown="MagneticLineView_MouseLeftButtonDown"/>
        <!--円のマスク-->
        <Path Fill="#f5f5f5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,50,0,0">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <!-- 全体の長方形 -->
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,600,600"/>
                    </CombinedGeometry.Geometry1>
                    <!-- くり抜く円 -->
                    <CombinedGeometry.Geometry2>
                        <EllipseGeometry Center="300,300" RadiusX="270" RadiusY="270"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>
        <!--円の線-->
        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top"
                 Height="540" Width="540" Stroke="Gray" StrokeThickness="1" Margin="270,80,0,0"/>
        <!--直線-->
        <Path Stroke="Gray" StrokeThickness="0.5">
            <Path.Data>
                <GeometryGroup>
                    <!--タテ実線-->
                    <LineGeometry StartPoint="270,0" EndPoint="270,600"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <Path Stroke="Gray" StrokeThickness="0.5" StrokeDashArray="5.0">
            <Path.Data>
                <GeometryGroup>
                    <!--ヨコ破線-->
                    <LineGeometry StartPoint="0,350" EndPoint="300,350"/>
                    <LineGeometry StartPoint="780,350" EndPoint="1080,350"/>
                    <!--センター破線-->
                    <LineGeometry StartPoint="540,0" EndPoint="540,110"/>
                    <LineGeometry StartPoint="540,590" EndPoint="540,690"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <!--Inclination Angleスライダー-->
        <Slider x:Name="MagneticLineSlider" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="780,170,0,0" Orientation="Vertical" Height="360"
                Maximum="180" Minimum="0" IsDirectionReversed="True" TickFrequency="10" Value="57"
                ValueChanged="ArrowSlider_ValueChanged" SmallChange="1" LargeChange="10"
                IsSnapToTickEnabled="False" Width="100"
                Loaded="Slider_Loaded">
            <Slider.Template>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <!--目盛りラベル-->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>
                        <Grid Margin="0,0,80,0">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Text="0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="90" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Text="180" VerticalAlignment="Bottom"/>
                        </Grid>
                        <!--目盛り線-->
                        <Border Background="Gray" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="1" Margin="30,0,0,0" Height="340"/>
                        <TickBar x:Name="TopTick" Fill="Gray" SnapsToDevicePixels="True"
                                 Placement="Right" Width="8" Margin="0,0,37,0"
                                 TickFrequency="{TemplateBinding TickFrequency}"
                                 Minimum="{TemplateBinding Minimum}"
                                 Maximum="{TemplateBinding Maximum}"
                                 Ticks="{TemplateBinding Ticks}">
                        </TickBar>
                        <!--つまみ-->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Style="{StaticResource ArrowThumbVerticalStyle}" Background="Gray"
                                       Width="40" Height="20" DragCompleted="Thumb_DragCompleted" Margin="30,0,0,0"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Slider.Template>
        </Slider>
        <!--Inclination Angleテキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="804,165,0,0" TextWrapping="Wrap" Text="Inclination Angle" 
                   Foreground="Gray" FontSize="10"
                   Background="#f5f5f5" Padding="5,0">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="-90"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <!--Magnetic Lineテキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="490,50,0,0" TextWrapping="Wrap" Text="Magnetic Line" 
                   Foreground="Gray" FontSize="12" Background="#f5f5f5"
                   Width="100" Height="16" TextAlignment="Center" FontFamily="Century Gothic" FontWeight="Bold"/>


        <!--破線-->
        <Path Stroke="Gray" StrokeThickness="0.5" StrokeDashArray="5.0">
            <Path.Data>
                <GeometryGroup>
                    <!--ヨコ-->
                    <LineGeometry StartPoint="810,610" EndPoint="1080,610"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <!--Polar Capテキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="890,602,0,0" TextWrapping="Wrap" Text="Polar Cap"
                   Foreground="Gray" FontSize="12" Background="#f5f5f5"
                   Width="80" TextAlignment="Center" FontFamily="Century Gothic" FontWeight="Bold"/>
        <!--ポーラーキャップ-->
        <gl:GLWpfControl x:Name="GLControlPolarCapSouthClosed"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="100" Height="100" Margin="760,560,0,0"
                         MouseWheel="ControlView_MouseWheel"/>

        <gl:GLWpfControl x:Name="GLControlPolarCapSouthOpened"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="100" Height="100" Margin="760,560,0,0"
                         MouseWheel="ControlView_MouseWheel"/>

        <gl:GLWpfControl x:Name="GLControlPolarCapNorthClosed"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="100" Height="100" Margin="760,560,0,0"
                         MouseWheel="ControlView_MouseWheel"/>

        <gl:GLWpfControl x:Name="GLControlPolarCapNorthOpened"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="100" Height="100" Margin="760,560,0,0"
                         MouseWheel="ControlView_MouseWheel"/>
        <!--円のマスク-->
        <Path Fill="#f5f5f5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="760,560,0,0">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <!-- 全体の長方形 -->
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,100,100"/>
                    </CombinedGeometry.Geometry1>
                    <!-- くり抜く円 -->
                    <CombinedGeometry.Geometry2>
                        <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>
        <!--円-->
        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top"
                 Height="100" Width="100" Stroke="Gray" StrokeThickness="1" Margin="760,560,0,0"/>
        <!-- South Close -->
        <Button x:Name="PolarCapSouthCloseButton"
                Style="{StaticResource ArrowButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="840,640,0,0" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="45"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <!-- South Open -->
        <Button x:Name="PolarCapSouthOpenButton"
                Style="{StaticResource ArrowButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="750,640,0,0" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-45"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <!-- North Close -->
        <Button x:Name="PolarCapNorthCloseButton"
                Style="{StaticResource ArrowButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="750,550,0,0" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-135"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <!-- North Open -->
        <Button x:Name="PolarCapNorthOpenButton"
                Style="{StaticResource ArrowButtonStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="840,550,0,0" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="135"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <!--方角（N/S）テキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="807,545,0,0" TextWrapping="Wrap" Text="N"
                   Foreground="Gray" FontSize="10"/>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="807,661,0,0" TextWrapping="Wrap" Text="S"
                   Foreground="Gray" FontSize="10"/>


        <!--スカイマップ-->
        <gl:GLWpfControl x:Name="GLControlSkyMap"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="540" Height="270" Margin="270,690,0,0"/>
        <!--実線-->
        <Path Stroke="Gray" StrokeThickness="1.0">
            <Path.Data>
                <GeometryGroup>
                    <!--ヨコ-->
                    <LineGeometry StartPoint="270,690" EndPoint="810,690"/>
                    <LineGeometry StartPoint="810,960" EndPoint="910,960"/>
                    <!--タテ-->
                    <LineGeometry StartPoint="270,690" EndPoint="270,590"/>
                    <LineGeometry StartPoint="810,690" EndPoint="810,960"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <!--破線-->
        <Path Stroke="Gray" StrokeThickness="0.5" StrokeDashArray="5.0">
            <Path.Data>
                <GeometryGroup>
                    <!--ヨコ-->
                    <LineGeometry StartPoint="0,690" EndPoint="230,690"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <!--Sky Mapテキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="135,682,0,0" TextWrapping="Wrap" Text="Sky Map"
                   Foreground="Gray" FontSize="12" Background="#f5f5f5"
                   Width="80" TextAlignment="Center" FontFamily="Century Gothic" FontWeight="Bold"/>
        <!--Phaseテキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="920,953,0,0" TextWrapping="Wrap" Text="Phase" 
                   Foreground="Gray" FontSize="10" RenderTransformOrigin="0.5,0.5"/>
        <!--Viewing Angleテキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="264,620,0,0" TextWrapping="Wrap" Text="Viewing Angle" 
                   Foreground="Gray" FontSize="10" Background="#f5f5f5" Width="80" TextAlignment="Center">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="-90"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>


        <!--PulseProfile-->
        <gl:GLWpfControl x:Name="GLControlPulseProfile"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="540" Height="370" Margin="270,961,0,0"
                         MouseWheel="ControlView_MouseWheel"/>
        <!--破線-->
        <!--タテ-->
        <Path x:Name="PathDashPulseProfile" Stroke="#e6e6e6" StrokeThickness="0.5" StrokeDashArray="5.0"/>
        <!--ヨコ-->
        <Path Stroke="Gray" StrokeThickness="0.5" StrokeDashArray="5.0">
            <Path.Data>
                <GeometryGroup>
                    <LineGeometry StartPoint="0,1230" EndPoint="1080,1220"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <!--実線-->
        <!--タテ-->
        <Path x:Name="PathStrokePulseProfile" Stroke="Gray" StrokeThickness="1.0"/>
        <!--PulseProfile テキスト-->
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="490,1222,0,0" TextWrapping="Wrap" Text="Pulse Profile" 
                   Foreground="Gray" FontSize="12" Background="White"
                   Width="100" TextAlignment="Center" FontFamily="Century Gothic" FontWeight="Bold"/>
        <!--Viewing Angleガイド-->
        <Canvas x:Name="SkyMapViewingAngleCanvas" Width="540" Height="270" Background="{x:Null}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="270,690,0,0">
            <Line x:Name="ViewingAngleLine" X1="0" X2="540" Stroke="Red" StrokeThickness="1.5"/>
        </Canvas>
        <!--Viewing Angleスライダー-->
        <Slider x:Name="SkyMapViewingAngleSlider" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="240,680,0,0" Orientation="Vertical" Height="290"
                Maximum="180" Minimum="0" IsDirectionReversed="True" TickFrequency="10" Value="90"
                ValueChanged="ArrowSlider_ValueChanged" SmallChange="1"
                IsSnapToTickEnabled="False" Width="640"
                Loaded="Slider_Loaded">
            <Slider.Template>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <!--タテ目盛りラベル-->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>
                        <Grid Margin="0,0,625,0">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Row="0" Text="0" VerticalAlignment="Top" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Text="90" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Text="180" VerticalAlignment="Bottom" Margin="0,3"/>
                        </Grid>
                        <!--タテ目盛り線-->
                        <Border Background="Gray" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="1" Margin="29.5,0,0,0" Height="270"/>
                        <TickBar x:Name="TopTick" Fill="Gray" SnapsToDevicePixels="True"
                                 HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                 Placement="Left" Width="8" Margin="22,0,0,0"
                                 TickFrequency="{TemplateBinding TickFrequency}"
                                 Minimum="{TemplateBinding Minimum}"
                                 Maximum="{TemplateBinding Maximum}"
                                 Ticks="{TemplateBinding Ticks}">
                        </TickBar>
                        <!--つまみ-->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Style="{StaticResource ArrowThumbVerticalStyle}" Background="Gray"
                                       Width="40" Height="20" DragCompleted="Thumb_DragCompleted" Margin="570,0,0,0"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Slider.Template>
        </Slider>
        <!--Phaseガイド-->
        <Canvas x:Name="SkyMapPhaseCanvas" Width="540" Height="428" Background="{x:Null}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="270,690,0,0">
            <Line x:Name="PhaseLine" Y1="0" Y2="428" Stroke="Red" StrokeThickness="1.5"/>
        </Canvas>
        <!--Phaseスライダー-->
        <Slider x:Name="SkyMapPhaseSlider" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Margin="250,960,0,0" Orientation="Horizontal" Width="580" Height="290"
                Maximum="360" Minimum="0" IsDirectionReversed="False" TickFrequency="10" Value="90"
                ValueChanged="ArrowSlider_ValueChanged" SmallChange="1" LargeChange="10"
                IsSnapToTickEnabled="False"
                Loaded="Slider_Loaded">
            <Slider.Template>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <!--ヨコ目盛りラベル-->
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Foreground" Value="Gray"/>
                                </Style>
                            </Grid.Resources>
                            <TextBlock Grid.Column="1" Text="0" Margin="11,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="90" Margin="150,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="180" Margin="281,0,0,0"/>
                            <TextBlock Grid.Column="6" Text="270" Margin="417,0,0,0"/>
                            <TextBlock Grid.Column="8" Text="360" Margin="564,0,0,0"/>
                        </Grid>
                        <!--ヨコ目盛り線-->
                        <Border Background="Gray" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="540" Margin="20,-0.5,0,0" Height="1"/>
                        <TickBar x:Name="TopTick" Fill="Gray" SnapsToDevicePixels="True"
                                 VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                 Placement="Bottom" Height="8"
                                 TickFrequency="{TemplateBinding TickFrequency}"
                                 Minimum="{TemplateBinding Minimum}"
                                 Maximum="{TemplateBinding Maximum}"
                                 Ticks="{TemplateBinding Ticks}">
                        </TickBar>
                        <!--つまみ-->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Style="{StaticResource ArrowThumbHorizontalStyle}" Background="Gray"
                                       Width="40" Height="20" VerticalAlignment="Bottom" Margin="0,0,0,90"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Slider.Template>
        </Slider>
    </Grid>
</Window>